{
  "name": "toolshop-e2e",
  "version": "1.0.0",
  "description": "UI- и API-автотесты для [Toolshop](https://practicesoftwaretesting.com) на Playwright и TypeScript.",
  "main": "index.js",
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,js,mjs}": [
      "eslint --max-warnings=0 --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": "prettier --write"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/irrbis38/toolshop-e2e.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/irrbis38/toolshop-e2e/issues"
  },
  "homepage": "https://github.com/irrbis38/toolshop-e2e#readme",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.4",
    "dotenv": "^18.0.5",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-playwright": "^2.12.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.9",
    "typescript-eslint": "^8.71.1"
  }
}
